# Environment Configuration Example
# Copy this file to .env.local and update values as needed

# API Configuration (for future integration)
VITE_API_BASE_URL=https://api.postkar.com
VITE_API_VERSION=v1

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ERROR_REPORTING=true

# Analytics Configuration
VITE_GOOGLE_ANALYTICS_ID=
VITE_MIXPANEL_TOKEN=

# Error Reporting
VITE_SENTRY_DSN=

# Development Settings
VITE_MOCK_API_DELAY=500
VITE_ENABLE_MOCK_DATA=true

# Image CDN Configuration
VITE_IMAGE_CDN_URL=https://cdn.postkar.com
VITE_IMAGE_OPTIMIZATION=true

# Scanner Configuration (for future use)
VITE_SCANNER_API_URL=https://scanner-api.postkar.com
VITE_ENABLE_CAMERA_PERMISSIONS=false