# Development Environment Configuration
# Spring Boot backend typically runs on port 8080
VITE_API_BASE_URL=http://localhost:8080
VITE_API_VERSION=v1
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ERROR_REPORTING=false
VITE_MOCK_API_DELAY=500
VITE_ENABLE_MOCK_DATA=false
VITE_IMAGE_CDN_URL=http://localhost:8080/images
VITE_IMAGE_OPTIMIZATION=false
VITE_SCANNER_API_URL=http://localhost:3002
VITE_ENABLE_CAMERA_PERMISSIONS=false